# Build this image only for the optional isolated secret import service.
FROM docker.io/golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /worker ./cmd/secret-store-worker \
    && mkdir -p /worker-socket \
    && chown 10001:10001 /worker-socket && chmod 0700 /worker-socket

FROM scratch
COPY --from=builder /worker /secret-store-worker
COPY --from=builder --chown=10001:10001 /worker-socket /run/secret-store
USER 10001:10001
ENTRYPOINT ["/secret-store-worker"]
