# Supply an immutable, platform-matching tools image containing the genuine IBM
# pvsecret binary plus its OpenSSL/runtime libraries. No downloaded tool or trust
# key is silently substituted at runtime. See docs/secret-flow.md.
ARG PVSECRET_TOOLS_IMAGE
FROM docker.io/golang:1.27-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /worker ./cmd/secret-store-worker \
    && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /consumer ./cmd/secret-consumer \
    && mkdir -p /worker-socket && chown 10001:10001 /worker-socket \
    && chmod 0700 /worker-socket

FROM ${PVSECRET_TOOLS_IMAGE}
COPY --from=builder /worker /usr/local/bin/secret-store-worker
COPY --from=builder /consumer /usr/local/bin/secret-consumer
COPY --from=builder --chown=10001:10001 /worker-socket /run/secret-store
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/secret-store-worker"]
